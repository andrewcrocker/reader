{
  "name": "reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config worker/wrangler.toml",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "deploy:app": "npm run build && wrangler pages deploy dist --project-name reader",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.14",
    "kokoro-js": "^1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
